<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFAC010：dpiAwareness 已手动声明在 app.manifest（指定 ApplicationManifest 时 SDK 不自动注入），
         与 Program.cs SetHighDpiMode(PerMonitorV2) 配合生效，抑制该提示性警告 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AssemblyName>LightGuard</AssemblyName>
    <RootNamespace>LightGuard</RootNamespace>
    <Version>3.6.0</Version>
    <AssemblyVersion>3.6.0.0</AssemblyVersion>
    <FileVersion>3.6.0.0</FileVersion>
    <Company>LightGuard</Company>
    <Product>LightGuard</Product>
    <Copyright>© 2026 落尘（Luochen）保留所有权利</Copyright>
    <Description>LightGuard V3.6 五合一全栈安全容灾审计系统 - Client-Server 自定义 TCP 备份（块级真增量/快照恢复/密码认证）</Description>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>assets\lightguard.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- 不固定 RuntimeIdentifier，支持 win-x64/win-arm64/win-x86 多架构构建 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <None Update="assets\lightguard.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Decryption\DecryptionToolIndex.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\lang\lang_zh-CN.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\lang\lang_en-US.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\lang\lang_zh-TW.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- C/S 自定义备份协议共享库（LightGuardServer 与客户端共用报文编解码） -->
    <ProjectReference Include="..\LightGuard.Shared\LightGuard.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- System.Management: WMI 查询（硬件检测、Windows Defender 状态查询） -->
    <PackageReference Include="LZMA-SDK" Version="22.1.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- System.ServiceProcess.ServiceController: Windows 服务管理（禁用流氓软件后台服务） -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 选择性还原测试项目访问内部方法（如 PrecheckTarget） -->
    <InternalsVisibleTo Include="SelectiveRecoveryTest" />
  </ItemGroup>

</Project>
