<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>false</UseWindowsForms>
    <AssemblyName>BlockIncrementalTest</AssemblyName>
    <RootNamespace>BlockIncrementalTest</RootNamespace>
    <!-- 引用的 LightGuard 是 self-contained 可执行文件，测试项目必须同步 -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- 引用真实 LightGuard 代码，验证块级增量引擎实际逻辑 -->
    <ProjectReference Include="..\..\src\LightGuard\LightGuard.csproj" />
  </ItemGroup>

</Project>
